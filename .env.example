# galgame2voice Environment Configuration
# Copy this file to .env and fill in your values

# Server binding
# HOST=127.0.0.1
# PORT=8080

# Logging
# LOG_LEVEL=INFO
# LOG_TO_FILE=true

# GPT-SoVITS Integration
# GPT_SOVITS_BASE_URL=http://127.0.0.1:9880

# Telegram Bot (optional)
# TELEGRAM_ENABLED=false
# TELEGRAM_TOKEN=your_bot_token_here
# TELEGRAM_PROXY=http://127.0.0.1:7890

# Audio retention (minutes)
# AUDIO_RETENTION_MINUTES=30

# Security
# GALGAME2VOICE_CONSOLE_TOKEN=your_fixed_console_token
# GALGAME2VOICE_ENABLE_DOCS=false
# TELEGRAM_ADMIN_IDS=123456789,987654321
# GALGAME2VOICE_RATE_LIMIT_DISABLED=0
