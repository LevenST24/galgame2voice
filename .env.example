# galgame2voice Environment Configuration
# Copy this file to .env and fill in your values

# Server binding
# GALGAME2VOICE_HOST=127.0.0.1
# GALGAME2VOICE_PORT=8080

# Logging
# GALGAME2VOICE_LOG_LEVEL=INFO
# GALGAME2VOICE_LOG_TO_FILE=true

# Security & Authentication
# GALGAME2VOICE_AUTH_DISABLED=0        # Set to 0 to enforce console token authentication (required in Docker/LAN/Public)
# GALGAME2VOICE_CONSOLE_TOKEN=your_token_here  # Overrides DB console token if set
# GALGAME2VOICE_ENABLE_DOCS=false      # Expose /docs and /redoc
# GALGAME2VOICE_RATE_LIMIT_DISABLED=0  # Set to 1 only in test suites
# GALGAME2VOICE_PRIVACY_MODE=false     # Set to true to bypass TTS disk/memory caching (no cache writes or hits). The cascade that unlinks a session's non-.ogg audio files on session delete/clear runs regardless of this flag.

# GPT-SoVITS Integration
# GALGAME2VOICE_GPT_SOVITS_BASE_URL=http://127.0.0.1:9880

# Audio Retention
# GALGAME2VOICE_AUDIO_RETENTION_MINUTES=30
# GALGAME2VOICE_AUDIO_CLEANUP_INTERVAL_SECONDS=600

# Telegram Bot (optional)
# NOTE: the bot's enabled flag, bot token and proxy are read from the settings row
# stored in SQLite (configured in the web console). The three GALGAME2VOICE_TELEGRAM_*
# aliases below are parsed into Settings but have no consumer, so setting them here
# does not enable or configure the bot.
# GALGAME2VOICE_TELEGRAM_ENABLED=false
# GALGAME2VOICE_TELEGRAM_TOKEN=your_bot_token_here
# GALGAME2VOICE_TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_ADMIN_IDS is read directly from the process environment (README.md table)
# and is merged with the console's telegram_admin_ids whitelist.
# TELEGRAM_ADMIN_IDS=123456789,987654321
