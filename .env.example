# galgame2voice 配置示例
# 复制本文件并改名为 .env，放在程序文件夹里（和「启动.bat」同一层），
# 去掉需要修改那一行开头的 #，再改等号后面的值。改完重新启动程序生效。
# 大多数设置也可以直接在网页的设置中心里改，不必写在这里。

# 监听地址和端口（启动参数 --host / --port 优先）
# GALGAME2VOICE_HOST=127.0.0.1
# GALGAME2VOICE_PORT=8080

# 日志
# GALGAME2VOICE_LOG_LEVEL=INFO          # 可选 DEBUG、INFO、WARNING、ERROR
# GALGAME2VOICE_LOG_TO_FILE=true        # 是否把日志写进 logs 文件夹

# 访问令牌与安全
# GALGAME2VOICE_AUTH_DISABLED=0         # 设为 0 启用访问令牌；局域网或 Docker 访问时必须为 0
# GALGAME2VOICE_CONSOLE_TOKEN=change-me   # 换成自己设的令牌，只用英文字母和数字；不填时自动生成，保存在 data/.console_token
# GALGAME2VOICE_ENABLE_DOCS=false       # 设为 true 开放 /docs 接口文档
# GALGAME2VOICE_RATE_LIMIT_DISABLED=0   # 仅供自动化测试使用，平时保持 0
# GALGAME2VOICE_PRIVACY_MODE=false      # 设为 true 时不把合成的语音存进磁盘缓存

# GPT-SoVITS 语音服务地址（系统环境变量和网页里保存的地址优先）
# GALGAME2VOICE_GPT_SOVITS_BASE_URL=http://127.0.0.1:9880

# 临时音频保留
# GALGAME2VOICE_AUDIO_RETENTION_MINUTES=30            # 临时合成音频保留多少分钟
# GALGAME2VOICE_AUDIO_CLEANUP_INTERVAL_SECONDS=600    # 每隔多少秒清理一次
